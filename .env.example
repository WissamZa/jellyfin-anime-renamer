# ── TMDB ──────────────────────────────────────────────────
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Provider ─────────────────────────────────────────────
# Options: tmdb, anilist, kitsu  (default: tmdb)
PROVIDER=tmdb

# ── Series (used by jellyfin_renamer.py manual CLI) ───────
# Leave blank to auto-detect from folder name / search
SERIES_NAME=
TMDB_SERIES_ID=
ANILIST_ID=
KITSU_ID=

# ── Paths ─────────────────────────────────────────────────
MEDIA_DIR=/path/to/your/episodes
BASE_DOWNLOAD_PATH=/mnt/D/Torrent

# ── Organisation ──────────────────────────────────────────
ORGANIZE_INTO_FOLDERS=true

# ── Absolute Episode Numbering ────────────────────────────
# When true, uses absolute episode numbers in filenames
# e.g. "One Piece - S23E1163 - Title.mkv" instead of
#      "One Piece - S23E28 - Title.mkv"
ABSOLUTE_NUMBERING=false

# ── TMDB Episode Groups ──────────────────────────────────
# Optional: TMDB episode group ID for custom season/episode ordering.
# Episode groups let you use alternative season structures (e.g. "Absolute Order"
# for long-running anime like One Piece) instead of the default TMDB seasons.
# Use option 8 in the interactive menu to browse available groups.
# Example: 5f5a11c5c4b3c7002196453
EPISODE_GROUP_ID=

# ── qBittorrent (used by qbit_hook.py) ────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=your_qbit_username
QBIT_PASSWORD=your_qbit_password
