# ── TMDB ──────────────────────────────────────────────────
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Provider ─────────────────────────────────────────────
# Options: tmdb, anilist, kitsu, anidb  (default: tmdb)
# anidb = ED2K hash-based file identification (most accurate)
PROVIDER=tmdb

# ── Series (used by jellyfin_renamer.py manual CLI) ───────
# Leave blank to auto-detect from folder name / search
SERIES_NAME=
TMDB_SERIES_ID=
ANILIST_ID=
KITSU_ID=

# ── AniDB (for hash-based file identification) ────────────
# Register a free account at: https://anidb.net/
# Required only when PROVIDER=anidb or --use-hash / --hash-organize is used
# NOTE: If you get error 505, you must register your client at:
#   https://wiki.anidb.net/UDP_API_Definition#Client_Registering
# If AniDB auth fails, hash-organize will automatically fall back to
# filename-based identification with AniList/TMDB title resolution.
ANIDB_USERNAME=
ANIDB_PASSWORD=
# Optional: API key for AES-128 encrypted session (increases security)
ANIDB_API_KEY=
# Client identification — MUST be registered at AniDB (see link above)
# The system will try fallback client names if auth fails with code 505.
ANIDB_CLIENT=jenameramer
ANIDB_CLIENT_VER=1
# When true, only uses cached data — no API calls to AniDB
ANIDB_OFFLINE=false

# ── Hash-based Identification ─────────────────────────────
# When true, computes ED2K hash for files that can't be identified
# by filename parsing and looks them up on AniDB. Works with any
# provider as a fallback — not just PROVIDER=anidb.
USE_HASH=false

# ── Recursive Scanning ────────────────────────────────────
# When true, scans subfolders recursively for video files
SCAN_RECURSIVE=false
# Maximum recursion depth (default: 3)
SCAN_DEPTH=3

# ── Paths ─────────────────────────────────────────────────
MEDIA_DIR=/path/to/your/episodes
BASE_DOWNLOAD_PATH=/mnt/D/Torrent

# ── Organisation ──────────────────────────────────────────
ORGANIZE_INTO_FOLDERS=true

# ── Absolute Episode Numbering ────────────────────────────
# When true, uses absolute episode numbers in filenames
# e.g. "One Piece - S23E1163 - Title.mkv" instead of
#      "One Piece - S23E28 - Title.mkv"
ABSOLUTE_NUMBERING=false

# ── Episode Start Mode ───────────────────────────────────
# Options: per_season, continuing  (default: per_season)
# per_season — each season starts at E01 (e.g. S02E01)
# continuing — episodes continue from previous season (e.g. S02E13)
EPISODE_START_MODE=per_season

# ── TMDB Episode Groups ──────────────────────────────────
# Optional: TMDB episode group ID for custom season/episode ordering.
# Episode groups let you use alternative season structures (e.g. "Absolute Order"
# for long-running anime like One Piece) instead of the default TMDB seasons.
# Use option 8 in the interactive menu to browse available groups.
# Example: 5f5a11c5c4b3c7002196453
EPISODE_GROUP_ID=

# ── qBittorrent (used by qbit_hook.py) ────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=your_qbit_username
QBIT_PASSWORD=your_qbit_password

# ── Subtitle Extensions ──────────────────────────────────
# Comma-separated list of subtitle extensions (default: .srt,.ass,.ssa,.sub,.vtt)
# SUBTITLE_EXTENSIONS=.srt,.ass,.ssa,.sub,.vtt
