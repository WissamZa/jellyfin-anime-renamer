# ── Provider ────────────────────────────────────────────────
# Which API to use for episode metadata:
#   tmdb    — The Movie Database (default, requires TMDB_API_KEY)
#   anilist — AniList GraphQL API (free, no API key needed)
#   kitsu   — Kitsu.io JSON API (free, best anime season splits)
#             Discovers all seasons via sequel chain (e.g. Re:Zero)
#PROVIDER=tmdb

# ── TMDB ──────────────────────────────────────────────────
# Get your free key at: https://www.themoviedb.org/settings/api
# Required when PROVIDER=tmdb, ignored when PROVIDER=anilist or kitsu
TMDB_API_KEY=your_tmdb_api_key_here

# ── Series (used by jellyfin_renamer.py manual CLI) ───────
# If not set, the series name is derived from the folder name.
# All IDs are auto-resolved via search when left commented out.
#SERIES_NAME=One Piece
#TMDB_SERIES_ID=37854
#ANILIST_ID=21
#KITSU_ID=1234

# ── Paths ─────────────────────────────────────────────────
MEDIA_DIR=/path/to/your/episodes
BASE_DOWNLOAD_PATH=/mnt/D/Torrent

# ── Organisation ──────────────────────────────────────────
ORGANIZE_INTO_FOLDERS=true

# ── qBittorrent (used by qbit_hook.py) ────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=your_qbit_username
QBIT_PASSWORD=your_qbit_password
