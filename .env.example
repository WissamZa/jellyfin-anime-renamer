# ── TMDB ──────────────────────────────────────────────────
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Series (used by jellyfin_renamer.py manual CLI) ───────
SERIES_NAME=One Piece
TMDB_SERIES_ID=37854
ANILIST_ID=21

# ── Paths ─────────────────────────────────────────────────
MEDIA_DIR=/path/to/your/episodes
BASE_DOWNLOAD_PATH=/mnt/D/Torrent

# ── Organisation ──────────────────────────────────────────
ORGANIZE_INTO_FOLDERS=true

# ── qBittorrent (used by qbit_hook.py) ────────────────────
QBIT_URL=http://localhost:8080
QBIT_USERNAME=your_qbit_username
QBIT_PASSWORD=your_qbit_password
