#!/usr/bin/env bash
# rename — run jellyfin_renamer.py from any directory
#
# Install (once):
#   chmod +x rename
#   sudo ln -s "$(pwd)/rename" /usr/local/bin/rename
#   # or add the project folder to your PATH
#
# Usage:
#   rename                          # interactive menu, MEDIA_DIR from .env
#   rename --path .                 # interactive menu, current directory
#   rename --path /mnt/D/Torrent/X  # interactive menu, specific folder
#   rename --path . --dry-run       # preview only
#   rename --path . --run           # live rename, no menu
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Grab the target script name from the first argument
TARGET_SCRIPT="$1"

# Remove the script name from the argument list ($@)
shift

exec uv run --project "$SCRIPT_DIR" "$SCRIPT_DIR/$TARGET_SCRIPT" "$@"
